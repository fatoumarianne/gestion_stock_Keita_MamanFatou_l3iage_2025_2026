<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="380.0" prefWidth="380.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.AddMouvementDialogController">
    <children>
        <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Nouveau mouvement" />

        <Label text="Produit" />
        <ComboBox fx:id="comboProduit" prefWidth="320.0" />

        <HBox spacing="20.0">
            <children>
                <RadioButton fx:id="radioEntree" text="Entrée" />
                <RadioButton fx:id="radioSortie" text="Sortie" />
            </children>
        </HBox>

        <Label text="Quantité" />
        <TextField fx:id="champQuantite" prefWidth="150.0" />

        <Label text="Motif" />
        <TextField fx:id="champMotif" promptText="Obligatoire pour une sortie" prefWidth="320.0" />

        <Label fx:id="labelApercu" style="-fx-font-style: italic;" />
        <Label fx:id="labelErreur" style="-fx-text-fill: red;" wrapText="true" prefWidth="340.0" />

        <HBox spacing="10.0">
            <children>
                <Button fx:id="boutonEnregistrer" onAction="#enregistrer" styleClass="btn-primaire" text="Enregistrer" />
                <Button onAction="#annuler" text="Annuler" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>